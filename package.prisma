#prisma 4.0
def package "luced-browser" {
    str owner = "dymokomi"
    str version = "0.2.1"
    str kind = "application"
    str language = "luce"
    str description = "A web browser written in Luce over the luce-browser engine (Ladybird's LibWeb ported to Luce Base), with the look of a brutalist grey-and-orange tool."
    str readme = "README.md"
    str entry = "src/main.luc"

    def application "bundle" {
        str name = "Luced Browser"
        str identifier = "com.luciaos.luced-browser"
    }

    def dependency "luce-ui" {
        str owner = "dymokomi"
        str version = "^0.18.0"
        str path = "../luce-ui"
    }

    def dependency "luce-browser-engine" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-browser-engine"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-std"
    }

    def dependency "luce-window" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-window"
    }

    def dependency "luce-gpu" {
        str owner = "dymokomi"
        str version = "^0.5.0"
        str path = "../luce-gpu"
    }

    def dependency "luce-color" {
        str owner = "dymokomi"
        str version = "^0.7.0"
        str path = "../luce-color"
    }

    def dependency "luce-clipboard" {
        str owner = "dymokomi"
        str version = "^0.6.0"
        str path = "../luce-clipboard"
    }
}
