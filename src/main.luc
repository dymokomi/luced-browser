## luced-browser's entry point: a window on the location the command line
## names (a URL, a file, or what an address field would take), else a new tab.

from luce_std import crash
from app import Browser

pub func main(arguments: list[str]) -> int!:
    # Crash reports (~/.luce/crashes, named after package.prisma's name and
    # version) from the start: a trap anywhere, the engine's set-up included,
    # is reported, and luce-ui starts the program again, with no arguments, to
    # show the report (Browser's Application comes first for that).
    crash.enable()
    let browser = Browser()
    browser.run(arguments)
    browser.close()
    return 0
