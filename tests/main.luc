## Headless checks of the browser: no window, the engine running for real.

from app import Browser
from browser_tests import browsing, tabs, loopback

pub func main(arguments: list[str]) -> int!:
    # One browser for every check: the engine is set up once per process. The
    # runner passes the test pages' directory and a directory to write in.
    let browser = Browser()
    browsing(browser, arguments[0])
    tabs(browser, arguments[0], arguments[1])
    loopback(browser)
    browser.close()
    print("PASS luced-browser")
    return 0
